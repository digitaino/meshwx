# meshcore-weather on the GOES receiver Pi. Copy to .env in the repo root.
# /dev/meshcore is the udev alias from deploy/99-meshcore-radio.rules (any
# board); without the rule use the device name, e.g. /dev/ttyUSB0. When the
# port is missing or silent the bot scans every USB serial port anyway.
MCW_SERIAL_PORT=/dev/meshcore
MCW_SERIAL_BAUD=115200
# One request channel for every weather bot, everywhere. Do not rename per city.
MCW_MESHCORE_CHANNEL=#meshwx
# The binary datagrams for apps. Name it the same as the text channel to
# carry both on one slot (MeshWX v5); empty turns broadcasts off.
MCW_MESHWX_CHANNEL=#meshwx-data

# Products come from the dish: goesproc writes EMWIN files here.
MCW_EMWIN_SOURCE=sdr
MCW_SDR_EMWIN_DIR=/home/digitaino/goes-images/emwin
MCW_SDR_POLL_INTERVAL=30
MCW_EMWIN_POLL_INTERVAL=60

# Coverage: everything within 120 km of the home city.
MCW_HOME_CITIES=Austin TX
MCW_HOME_RADIUS_KM=120
MCW_TIMEZONE=America/Chicago

# Portal on 8081 (8080 is the goestools dashboard).
MCW_PORTAL_ENABLED=true
MCW_PORTAL_HOST=0.0.0.0
MCW_PORTAL_PORT=8081
MCW_ADMIN_KEY=change-me

# Replies: dm (default) | channel (flood every reply, for tests) | dm_only
MCW_REPLY_MODE=dm
MCW_CHANNEL_REPLY_MAX_HOPS=2
MCW_ADVERT_INTERVAL_HOURS=6

# The node holds 100 contacts and can only DM people it has stored. Keep the
# table for people: remove repeaters/rooms/sensors, and the people heard
# longest ago when fewer than KEEP_FREE slots would be left. false = firmware default.
MCW_CONTACT_HOUSEKEEPING=true
MCW_CONTACT_KEEP_FREE=10

# A replacement radio can take over the saved identity (key, name, position,
# LoRa settings, contacts). manual (default): the portal asks first, under
# Radio > Hardware. auto: written on first connect. off: never. docs/Radio_Swap.md.
MCW_RADIO_ADOPT=manual

# Receive-only until the system is signed off.
MCW_TX_ENABLED=false
MCW_MQTT_ENABLED=false
MCW_LOG_LEVEL=INFO
