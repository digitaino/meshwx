# meshcore-weather on a GOES receiver Pi. Copy to .env in the repo root, fill
# in your own city, then `.venv/bin/meshcore-weather --check` before going on
# air (README, "Running a bot in another city").
# /dev/meshcore is the udev alias from deploy/99-meshcore-radio.rules (any
# board); without the rule use the device name, e.g. /dev/ttyUSB0. When the
# port is missing or silent the bot scans every USB serial port anyway.
MCW_SERIAL_PORT=/dev/meshcore
MCW_SERIAL_BAUD=115200
# Where the radio may transmit: US (902-928 MHz) or EU (863-870 MHz).
MCW_RADIO_REGION=US
# One request channel for every weather bot, everywhere. Do not rename per city.
MCW_MESHCORE_CHANNEL=#meshwx
# The MeshWX v5 datagrams for apps, on the same #meshwx slot (spec 2.1).
# Empty turns broadcasts off.
MCW_MESHWX_CHANNEL=#meshwx

# Products come from the dish: goesproc writes EMWIN files here.
MCW_EMWIN_SOURCE=sdr
MCW_SDR_EMWIN_DIR=~/goes-images/emwin
MCW_SDR_POLL_INTERVAL=30
# Radar pictures (`>radar`, spec 13) are read from the same directory: goesproc
# writes the EMWIN radar GIFs next to the text. Set MCW_RADAR_DIR only when
# they are somewhere else.
MCW_EMWIN_POLL_INTERVAL=60
# The goestools dashboard on this Pi: the sat reply, the Satellite page and
# the receiver lines in the log read it, every 10 s. Always the local
# address: a poll through the public hostname goes out and back through
# Cloudflare, and fails with it.
MCW_SDR_DASHBOARD_URL=http://127.0.0.1:8080
# ... and the address a person is given for it (the portal's link, the
# public bundle). Empty = the same as MCW_SDR_DASHBOARD_URL.
# MCW_SDR_DASHBOARD_PUBLIC_URL=https://goes.example.org
# The dish's internet backup (README, Configuration reference, EMWIN): on
# after this many quiet minutes, off once the dish has written
# MCW_SDR_RESUME_MIN_FILES of its own files in ten minutes. The defaults
# (10, 20) suit this dish.
# MCW_SDR_INTERNET_FALLBACK_MIN=10
# MCW_SDR_RESUME_MIN_FILES=20
# Operational status lines (lock lost or back, internet backup on or off,
# products hours behind, dashboard, disk or temperature) go on this public
# channel; join it by name on any node. Never the request channel. Empty =
# no status lines.
# MCW_STATUS_CHANNEL=#meshwx-status

# Coverage: everything within the radius of the home city, written "City ST".
# Empty = the scheduled warnings, digest and observations send nothing.
MCW_HOME_CITIES=
# The radius your mesh really reaches, not more.
MCW_HOME_RADIUS_KM=120
# Empty = the zone of the home city's state; set it where a state has two.
# MCW_TIMEZONE=

# Portal on 8081 (8080 is the goestools dashboard), this machine only: the
# dashboard reaches it on 127.0.0.1, you over `ssh -N -L 8081:127.0.0.1:8081`.
# No login, so never 0.0.0.0 without MCW_PORTAL_ALLOWED_HOSTS and a LAN you trust.
MCW_PORTAL_ENABLED=true
MCW_PORTAL_HOST=127.0.0.1
MCW_PORTAL_PORT=8081
# Debug bridge for app development (README, "The debug bridge"). Empty = off
# (404). With it set, reach the portal over `ssh -N -L 8080:127.0.0.1:8081`.
MCW_BRIDGE_TOKEN=
# The first 12 hex characters of YOUR OWN public key (8 at the very least);
# the bot logs every DM sender's prefix.
MCW_ADMIN_KEY=

# Replies: dm (default; the right one where meshes overlap) | channel (flood
# every reply) | dm_only
MCW_REPLY_MODE=dm
MCW_CHANNEL_REPLY_MAX_HOPS=2
MCW_ADVERT_INTERVAL_HOURS=6

# The node can only DM people it has stored. Keep the table for people:
# remove repeaters/rooms/sensors, and the people heard longest ago when fewer
# than KEEP_FREE slots would be left. false = firmware default.
MCW_CONTACT_HOUSEKEEPING=true
MCW_CONTACT_KEEP_FREE=10

# A packet no repeater echoed is sent once more, byte for byte.
MCW_RETRANSMIT_MAX=1
# Optional CoreScope instance: stats = annotate who heard each packet,
# decide = also skip a resend CoreScope saw repeated. Empty = off.
# MCW_SCOPE_URL=https://scope.example.org
# MCW_SCOPE_MODE=stats

# A replacement radio can take over the saved identity (key, name, position,
# LoRa settings, contacts). manual (default): the portal asks first, under
# Radio > Hardware. auto: written on first connect. off: never. docs/Radio_Swap.md.
MCW_RADIO_ADOPT=manual

# Receive-only until --check is clean, the log looks right and your local
# repeater operators have agreed the airtime and area.
MCW_TX_ENABLED=false
MCW_MQTT_ENABLED=false
MCW_LOG_LEVEL=INFO
