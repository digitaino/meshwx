# meshcore-weather settings for a dev box (EMWIN over the internet).
# Copy to .env and edit. Every setting and its default: README.md,
# "Configuration reference". The receiver Pi uses deploy/pi.env.example.

# The MeshCore companion radio on USB (macOS /dev/cu.usbserial-0001, Linux
# /dev/ttyUSB0), or tcp://host:port for a radio behind a TCP bridge.
# docker-compose.yml overrides this with tcp://host.docker.internal:4403.
MCW_SERIAL_PORT=/dev/cu.usbserial-0001
MCW_SERIAL_BAUD=115200

# The request channel people and apps use. Never slot 0 (the public channel).
MCW_MESHCORE_CHANNEL=#meshwx
# MeshWX v5 datagrams for apps. The same name as the request channel shares
# one slot, which is where v5 apps listen. Empty turns broadcasts off.
MCW_MESHWX_CHANNEL=#meshwx

# EMWIN from NOAA over the internet, refreshed every 120 s.
MCW_EMWIN_SOURCE=internet
MCW_EMWIN_POLL_INTERVAL=120

# Coverage: every forecast zone within the radius of the first city, plus any
# states or offices listed. The first city is also the home forecast point.
MCW_HOME_CITIES=Austin TX
MCW_HOME_RADIUS_KM=120
# MCW_HOME_STATES=TX
# MCW_HOME_WFOS=EWX
MCW_TIMEZONE=America/Chicago

# Admin portal (install with the [portal] extra). It has no login: LAN only.
MCW_PORTAL_ENABLED=true
MCW_PORTAL_HOST=0.0.0.0
MCW_PORTAL_PORT=8080

# Hex public-key prefix of the person allowed to run admin commands by DM.
# The bot logs it with every DM: "DM from <name> (<prefix>): ...".
MCW_ADMIN_KEY=

# false = receive only: no adverts, replies or datagrams go out.
MCW_TX_ENABLED=true
MCW_LOG_LEVEL=INFO
