# meshcore-weather settings for a dev box (EMWIN over the internet).
# Copy to .env and edit. Every setting and its default: README.md,
# "Configuration reference". The receiver Pi uses deploy/pi.env.example.
# Running a bot in another city: README.md, "Running a bot in another city".
# Check what you wrote with `meshcore-weather --check` before going on air.

# The MeshCore companion radio on USB (macOS /dev/cu.usbserial-0001, Linux
# /dev/ttyUSB0), or tcp://host:port for a radio behind a TCP bridge.
# docker-compose.yml overrides this with tcp://host.docker.internal:4403.
MCW_SERIAL_PORT=/dev/cu.usbserial-0001
MCW_SERIAL_BAUD=115200
# Where the radio may transmit: US (902-928 MHz) or EU (863-870 MHz). Other
# frequencies are refused, and a node found on one has transmit switched off.
MCW_RADIO_REGION=US

# The request channel people and apps use. Never slot 0 (the public channel).
# Leave it #meshwx: every bot and app in every city uses that one name.
MCW_MESHCORE_CHANNEL=#meshwx
# MeshWX v5 datagrams for apps. The same name as the request channel shares
# one slot, which is where v5 apps listen. Empty turns broadcasts off.
MCW_MESHWX_CHANNEL=#meshwx

# EMWIN from NOAA over the internet, refreshed every 60 s.
MCW_EMWIN_SOURCE=internet
MCW_EMWIN_POLL_INTERVAL=60
# How NOAA's administrators can reach you (an email address or URL), sent in
# the User-Agent of every bundle fetch so they can ask instead of blocking.
# MCW_OPERATOR_CONTACT=you@example.org

# Coverage: every forecast zone within the radius of the first city, plus any
# states or offices listed. The first city is also the home forecast point.
# Write it as "City ST" (a bare name like "Springfield" is in many states and
# is refused). With no coverage at all the scheduled warnings, digest and
# observations send NOTHING; MCW_COVERAGE=national is the only way to
# broadcast every warning in the country.
MCW_HOME_CITIES=
# The radius your mesh really reaches, not more.
MCW_HOME_RADIUS_KM=120
# MCW_HOME_STATES=
# MCW_HOME_WFOS=
# MCW_COVERAGE=national
# Empty = the time zone of the home city's state. Set it where a state has
# two (TX, FL, KY, TN, IN, MI, ...): e.g. America/Denver.
# MCW_TIMEZONE=

# Ceiling on scheduled broadcasts, every job together. Tornado, severe
# thunderstorm, flash flood and extreme wind warnings always go.
# MCW_SCHEDULED_PACKETS_PER_HOUR=120

# Admin portal (install with the [portal] extra). It has no login: it listens
# on this machine only. From elsewhere use an SSH tunnel:
#   ssh -N -L 8080:127.0.0.1:8080 you@this-machine   then http://localhost:8080
MCW_PORTAL_ENABLED=true
MCW_PORTAL_HOST=127.0.0.1
MCW_PORTAL_PORT=8080
# Host names the portal answers besides localhost/127.0.0.1/[::1], if you
# bind it to a LAN address on purpose: e.g. mesh-wx.local,10.0.0.51
# MCW_PORTAL_ALLOWED_HOSTS=
# Debug bridge for app development (README, "The debug bridge"): a client
# reads the transmitted datagrams and posts `>` requests over HTTP. Empty
# = off (404). Set it only with the portal on localhost or behind a tunnel.
MCW_BRIDGE_TOKEN=

# The first 12 hex characters of YOUR OWN public key: the only person allowed
# to run admin commands by DM. Shorter than 8 is refused. The bot logs every
# DM sender: "DM from <name> (<prefix>): ...".
MCW_ADMIN_KEY=

# Start receive-only. Run `meshcore-weather --check`, start the bot, watch the
# log, agree airtime and area with your local repeater operators, and only
# then set true (or switch Transmit on in the portal).
MCW_TX_ENABLED=false
MCW_LOG_LEVEL=INFO
