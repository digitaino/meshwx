# Connection mode: "tcp" (default, via meshcore-proxy) or "serial" (direct USB)
OBSERVER_MODE=tcp

# meshcore-proxy endpoint (used when OBSERVER_MODE=tcp)
PROXY_HOST=127.0.0.1
PROXY_PORT=5000

# Direct serial mode (used when OBSERVER_MODE=serial). Use a stable
# /dev/serial/by-id/... path so kernel re-enumeration doesn't change it.
# Find yours with:  ls -l /dev/serial/by-id/
# In serial mode the observer is the SOLE consumer of the radio — stop
# meshcore-proxy / Companion app first.
# SERIAL_PORT=/dev/serial/by-id/usb-CHANGE_ME
# SERIAL_BAUD=115200

# Seconds to wait for the radio's APPSTART handshake.
# Bump if you see "Radio did not respond to APPSTART" on slow hardware
# or when other clients (e.g. the Companion app) share the proxy.
MESHCORE_TIMEOUT=30

# AUS Meshcore broker
MQTT_HOST=mqtt.digitaino.com
MQTT_PORT=443
MQTT_TLS=true
MQTT_TRANSPORT=websockets
MQTT_USERNAME=__USERNAME__
MQTT_PASSWORD=__PASSWORD__
MQTT_IATA=__IATA__
