# MeshCore signed-token MQTT broker — observer ingress for CoreScope.
# Copy to .env and fill in the subscriber password. .env is gitignored.
#
# There are NO observer credentials here by design: observers authenticate by
# signing a token with their own MeshCore Ed25519 key, and may only publish to
# meshcore/{IATA}/{their own pubkey}/*. The accounts below are read-only
# consumers of that firehose.

# --- listener ---------------------------------------------------------------
# Plain ws:// on 8883. TLS is terminated at the Cloudflare edge; the tunnel
# forwards to this port over the LAN, so nothing here speaks TLS.
MQTT_WS_PORT=8883
MQTT_HOST=0.0.0.0

# --- authentication ---------------------------------------------------------
# Must exactly match the `aud` claim observers sign into their token, which in
# practice means the public hostname they connect to.
AUTH_EXPECTED_AUDIENCE=obs.digitaino.com

# --- read-only subscribers --------------------------------------------------
# Format: SUBSCRIBER_N=username:password:role[:maxConnections]
#   role 1 = admin       — adds /internal (PII) + $SYS + delete-retained
#   role 2 = full access — every public topic, unfiltered
#   role 3 = limited     — public topics with SNR/RSSI/stats/model stripped
# CoreScope needs role 2: role 3 would strip the RF fields its analytics are
# built on, and it has no business reading /internal.
SUBSCRIBER_MAX_CONNECTIONS_DEFAULT=2
SUBSCRIBER_1=corescope:REPLACE_WITH_openssl_rand_-hex_16:2

# --- abuse detection --------------------------------------------------------
# Starts in observe-only mode: every rule evaluates and logs, nothing is
# enforced. Watch the logs across a few days of real observer traffic, confirm
# legitimate observers aren't tripping anything, then flip to true.
ABUSE_ENFORCEMENT_ENABLED=false

ABUSE_DUPLICATE_WINDOW_SIZE=100
ABUSE_DUPLICATE_WINDOW_MS=300000
ABUSE_DUPLICATE_THRESHOLD=10
ABUSE_MAX_DUPLICATES_PER_PACKET=5
ABUSE_DUPLICATE_RATE_THRESHOLD=0.3
ABUSE_DUPLICATE_RATE_WINDOW_MS=300000

ABUSE_BUCKET_CAPACITY=20
ABUSE_BUCKET_REFILL_RATE=3

ABUSE_MAX_PACKET_SIZE=255
ABUSE_MAX_TOPICS_PER_DAY=3
ABUSE_ANOMALY_THRESHOLD=10
ABUSE_MAX_IATA_CHANGES_24H=3

ABUSE_TOPIC_HISTORY_SIZE=50
ABUSE_TOPIC_HISTORY_WINDOW_MS=86400000

ABUSE_PERSISTENCE_PATH=/data/abuse-detection.db
ABUSE_PERSISTENCE_INTERVAL_MS=300000
ABUSE_STATE_RETENTION_MS=604800000
